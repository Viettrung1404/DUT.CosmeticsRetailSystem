{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run All",
      "dependsOn": [
        "Backend: start:prod",
        "Backend: tunnel:payment",
        "Frontend: start:https",
        "Mobile: expo start"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "Backend: start:prod",
      "type": "shell",
      "command": "npm run start:prod",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      }
    },
    {
      "label": "Backend: tunnel:payment",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-Command",
        "Write-Host 'Waiting for backend (http://localhost:3000/api/v1/health/ready)...'; while ($true) { try { if ((Invoke-WebRequest -UseBasicParsing -TimeoutSec 2 'http://localhost:3000/api/v1/health/ready').StatusCode -eq 200) { break } } catch {} Start-Sleep -Seconds 2 }; npm run tunnel:payment"
      ],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      }
    },
    {
      "label": "Frontend: start:https",
      "type": "shell",
      "command": "npm run start:https",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      }
    },
    {
      "label": "Mobile: expo start",
      "type": "shell",
      "command": "npx expo start",
      "options": {
        "cwd": "${workspaceFolder}/mobile"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      }
    }
  ]
}
