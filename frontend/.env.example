# Server only. Include the Nest global API prefix; no trailing slash needed.
BACKEND_API_BASE_URL=http://localhost:3000/api/v1
SITE_URL=http://localhost:3001
BACKEND_TIMEOUT_MS=5000
# Local SSR connectivity page /dev/backend. Always disabled in production.
FE_DIAGNOSTICS=true
# FE-01 session infrastructure (not consumed by FE-00): isolated Redis namespace,
# TLS in production, ACL restricted to web sessions; never NEXT_PUBLIC_*.
# SESSION_REDIS_URL=redis://localhost:6379
# SESSION_KEY_PREFIX=glowup:web:session:
