# Server only. Include the Nest global API prefix; no trailing slash needed.
BACKEND_API_BASE_URL=http://localhost:3000/api/v1
SITE_URL=http://localhost:3001
BACKEND_TIMEOUT_MS=5000
# Local SSR connectivity page /dev/backend. Always disabled in production.
FE_DIAGNOSTICS=true
# Server-side session store. Upstash may be shared with backend using a separate prefix.
# Copy the backend REDIS_URL value privately into .env.local; never NEXT_PUBLIC_*.
SESSION_REDIS_URL=rediss://default:your-token@your-database.upstash.io:6379
SESSION_KEY_PREFIX=glowup:frontend:local:session:
# Must not exceed backend JWT_REFRESH_EXPIRES_IN. Fixed web lifetime, no sliding renewal.
SESSION_MAX_AGE_SECONDS=604800
# Provider exchange routes stay disabled until real provider smoke tests pass.
OAUTH_GOOGLE_VERIFIED=false
OAUTH_FACEBOOK_VERIFIED=false
MAINTENANCE_MODE=false
MAINTENANCE_RETRY_AFTER=300
# Optional plain text message. Requires server restart after changes.
# MAINTENANCE_MESSAGE=GlowUp đang bảo trì. Vui lòng quay lại sau.
