# ===== Ứng dụng =====
# development | production (production bật kiểm tra JWT_SECRET mạnh, CORS HTTPS, Upstash bắt buộc)
NODE_ENV=development
PORT=3000
# Tiền tố đường dẫn API
API_PREFIX=api/v1
# Bật Swagger tại /api/docs; mặc định bật, đặt false khi chạy production công khai
SWAGGER_ENABLED=true

# ===== Cơ sở dữ liệu (Neon PostgreSQL) =====
# Khi deploy dùng host có "-pooler"; thêm connection_limit (tối đa 20 mỗi tiến trình) cho vừa hạn mức của Neon
DATABASE_URL="postgresql://neondb_owner:password@ep-xxxxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&connection_limit=5"
# Ghi log từng câu truy vấn Prisma (chỉ dùng khi gỡ lỗi)
PRISMA_LOG_QUERIES=false

# ===== JWT =====
# Production: tối thiểu 32 ký tự, không dùng giá trị mẫu này
JWT_SECRET=super_secret_jwt_key_glowup_cosmetics_retail_system_2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_glowup_cosmetics_2026
JWT_REFRESH_EXPIRES_IN=7d

# ===== Kho ảnh (Cloudflare R2 qua giao thức S3) =====
# Bỏ trống thì API upload ảnh trả 503
STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
STORAGE_REGION=auto
STORAGE_BUCKET=glowup-images
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Địa chỉ công khai để mở ảnh
STORAGE_PUBLIC_URL="https://images.example.com"
# Bucket riêng (không công khai) chứa ảnh bằng chứng đổi trả
RETURN_STORAGE_BUCKET=
RETURN_STORAGE_PRIVATE=false

# ===== Thanh toán online =====
# Chỉ bật khi đã có tài khoản merchant, hạn mức và địa chỉ callback HTTPS
PAYMENT_PUBLIC_BASE_URL=https://your-api.example/api/v1
PAYMENT_WEB_RETURN_URL=https://your-web.example/payment/return
PAYMENT_QUERY_IP=127.0.0.1
# Worker tự hủy/đối soát thanh toán treo
PAYMENT_WORKER_ENABLED=true
VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_MIN_AMOUNT=5000
VNPAY_MAX_AMOUNT=50000000
VNPAY_MAX_QPS=
MOMO_ENABLED=false
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_CREATE_URL=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_QUERY_URL=https://test-payment.momo.vn/v2/gateway/api/query
MOMO_MIN_AMOUNT=1000
MOMO_MAX_AMOUNT=50000000
MOMO_MAX_QPS=
ZALOPAY_ENABLED=false
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_CREATE_URL=https://sb-openapi.zalopay.vn/v2/create
ZALOPAY_QUERY_URL=https://sb-openapi.zalopay.vn/v2/query
# Hạn mức và timeout ZaloPay phải xác nhận với merchant, không tự đoán
ZALOPAY_MIN_AMOUNT=
ZALOPAY_MAX_AMOUNT=
ZALOPAY_MAX_QPS=
ZALOPAY_CALLBACK_TIMEOUT_MS=

# ===== Email và thông báo =====
# Worker gửi email từ hàng đợi email_outbox; đặt false để tắt
EMAIL_OUTBOX_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=GlowUp <noreply@glowup.vn>
# Chỉ bật sau khi SMTP/FCM đã cấu hình và thử xong
NOTIFICATION_DELIVERY_ENABLED=false
# Khóa dịch vụ FCM (JSON), chỉ để ở máy chủ, không lộ ra Web/Mobile
FCM_SERVICE_ACCOUNT_JSON=
# Worker gửi chiến dịch email/thông báo hàng loạt (marketing)
BROADCAST_WORKER_ENABLED=false

# ===== Cache, giới hạn tốc độ (Upstash) =====
# Không đưa token thật vào file này
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
# One bounded attempt; do not retry rate-limit INCR/EVAL after an uncertain outcome.
UPSTASH_REDIS_TIMEOUT_MS=4000
REDIS_URL=rediss://default:your-token@your-database.upstash.io:6379
# Tách khóa giữa các môi trường dùng chung một Redis
REDIS_KEY_PREFIX=glowup:development:

# ===== Tìm kiếm sản phẩm (Elasticsearch) =====
ELASTICSEARCH_NODE=http://localhost:9200
# Worker đồng bộ chỉ mục sản phẩm; bật sau khi áp migration và cấu hình Elasticsearch
CATALOG_INDEX_WORKER_ENABLED=false

# ===== Web và CORS =====
PUBLIC_WEB_URL=http://localhost:3001
# Địa chỉ API khách truy cập được; dùng cho link theo dõi mở/nhấp và hủy nhận trong email marketing. Bỏ trống thì email vẫn gửi nhưng không theo dõi
PUBLIC_API_URL=http://localhost:3000/api/v1
FRONTEND_URL=http://localhost:3001
# Danh sách origin Web/Admin, cách nhau bằng dấu phẩy; production bắt buộc HTTPS
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
# true chỉ trên website công khai thật; local/staging để false
SEO_INDEXING_ENABLED=false
# IP/CIDR của proxy tin cậy (load balancer), cách nhau bằng dấu phẩy; bỏ trống khi chạy trực tiếp
TRUSTED_PROXIES=

# ===== Đăng nhập mạng xã hội =====
# Client ID Google của Web/Mobile, cách nhau bằng dấu phẩy (không cần client secret)
GOOGLE_OAUTH_CLIENT_IDS=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Phiên bản Graph API của ứng dụng Meta, ví dụ v24.0
FACEBOOK_GRAPH_VERSION=

# ===== Seed dữ liệu bắt buộc (npm run seed:production) =====
# Admin đầu tiên; thiếu một trong hai biến thì bỏ qua. Đặt mật khẩu mạnh, xóa khỏi môi trường sau khi seed
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Quản trị viên

# ===== Chỉ dùng cho kiểm thử =====
# CSDL tích hợp riêng; không bao giờ trỏ vào CSDL dùng chung
# TEST_DATABASE_URL=postgresql://postgres:sprint3_test_only@localhost:55433/glowup_sprint3_test?connection_limit=20
