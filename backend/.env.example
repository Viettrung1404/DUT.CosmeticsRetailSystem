# Application Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Neon PostgreSQL Database
# Thay thế chuỗi kết nối bằng DATABASE_URL từ bảng điều khiển Neon của bạn:
DATABASE_URL="postgresql://neondb_owner:password@ep-xxxxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_glowup_cosmetics_retail_system_2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_glowup_cosmetics_2026
JWT_REFRESH_EXPIRES_IN=7d

# Cloudflare R2 via S3. Leave unset to disable image uploads (503).
STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
STORAGE_REGION=auto
STORAGE_BUCKET=glowup-images
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL="https://images.example.com"

# Sprint 3: enable only after merchant credentials, limits/quota and HTTPS callback readiness.
# Append connection_limit=20&pool_timeout=2 to DATABASE_URL after confirming DB capacity.
PAYMENT_PUBLIC_BASE_URL=https://your-api.example/api/v1
PAYMENT_WEB_RETURN_URL=https://your-web.example/payment/return
PAYMENT_QUERY_IP=127.0.0.1
PAYMENT_WORKER_ENABLED=true
VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_MIN_AMOUNT=5000
VNPAY_MAX_AMOUNT=50000000
VNPAY_MAX_QPS=
MOMO_ENABLED=false
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_CREATE_URL=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_QUERY_URL=https://test-payment.momo.vn/v2/gateway/api/query
MOMO_MIN_AMOUNT=1000
MOMO_MAX_AMOUNT=50000000
MOMO_MAX_QPS=
ZALOPAY_ENABLED=false
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_CREATE_URL=https://sb-openapi.zalopay.vn/v2/create
ZALOPAY_QUERY_URL=https://sb-openapi.zalopay.vn/v2/query
# Do not invent generic ZaloPay limits/HTTP timeout; confirm these with the merchant.
ZALOPAY_MIN_AMOUNT=
ZALOPAY_MAX_AMOUNT=
ZALOPAY_MAX_QPS=
ZALOPAY_CALLBACK_TIMEOUT_MS=

EMAIL_OUTBOX_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=GlowUp <noreply@glowup.vn>

# Isolated integration database only; never set this to the shared Neon database.
# TEST_DATABASE_URL=postgresql://postgres:sprint3_test_only@localhost:55433/glowup_sprint3_test?connection_limit=20

# Sprint 4: private evidence bucket, separate from the public catalog bucket.
RETURN_STORAGE_BUCKET=
RETURN_STORAGE_PRIVATE=false

# Enable only after SMTP/FCM are configured and integration-tested.
NOTIFICATION_DELIVERY_ENABLED=false
# Server-side secret, never exposed in Web/Mobile or API exports.
FCM_SERVICE_ACCOUNT_JSON=

# Upstash REST is used for cache and coupon rate limiting. Never put live tokens in this file.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
# One bounded attempt; do not retry rate-limit INCR/EVAL after an uncertain outcome.
UPSTASH_REDIS_TIMEOUT_MS=4000
REDIS_URL=rediss://default:your-token@your-database.upstash.io:6379
# Isolate namespaces between environments. The REST adapter does not need REDIS_URL.
REDIS_KEY_PREFIX=glowup:development:
# Enable after applying Sprint 5 migration and verifying external provider configuration.
CATALOG_INDEX_WORKER_ENABLED=false
BROADCAST_WORKER_ENABLED=false

# Sprint 6: website origin and exact Web/Admin CORS origins (comma-separated).
# Production requires HTTPS and a strong JWT_SECRET, and configured Upstash for rate limits.
PUBLIC_WEB_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
# Keep false on local/staging; true only on the public production website.
SEO_INDEXING_ENABLED=false
# Explicit trusted proxy IPs/CIDRs only; leave blank when directly exposed locally.
TRUSTED_PROXIES=

# Web/Mobile Google client IDs, comma-separated. No Google client secret required for ID-token verification.
GOOGLE_OAUTH_CLIENT_IDS=
# Classic Facebook Login access-token flow; Limited Login JWT is not accepted.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Set the supported Graph API version from your registered Meta app (e.g. v24.0).
FACEBOOK_GRAPH_VERSION=
