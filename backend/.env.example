# Application Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Neon PostgreSQL Database
# Thay thế chuỗi kết nối bằng DATABASE_URL từ bảng điều khiển Neon của bạn:
DATABASE_URL="postgresql://neondb_owner:password@ep-xxxxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_glowup_cosmetics_retail_system_2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_glowup_cosmetics_2026
JWT_REFRESH_EXPIRES_IN=7d

# Kho lưu ảnh (Supabase Storage qua giao thức S3). Bỏ trống thì server vẫn chạy, chỉ API upload trả 503
STORAGE_ENDPOINT="https://<project-ref>.storage.supabase.co/storage/v1/s3"
STORAGE_REGION=ap-southeast-1
STORAGE_BUCKET=glowup-images
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL="https://<project-ref>.supabase.co/storage/v1/object/public/glowup-images"

# Sprint 3: enable only after merchant credentials, limits/quota and HTTPS callback readiness.
# Append connection_limit=20&pool_timeout=2 to DATABASE_URL after confirming DB capacity.
PAYMENT_PUBLIC_BASE_URL=https://your-api.example/api/v1
PAYMENT_WEB_RETURN_URL=https://your-web.example/payment/return
PAYMENT_QUERY_IP=127.0.0.1
PAYMENT_WORKER_ENABLED=true
VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_MIN_AMOUNT=5000
VNPAY_MAX_AMOUNT=50000000
VNPAY_MAX_QPS=
MOMO_ENABLED=false
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_CREATE_URL=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_QUERY_URL=https://test-payment.momo.vn/v2/gateway/api/query
MOMO_MIN_AMOUNT=1000
MOMO_MAX_AMOUNT=50000000
MOMO_MAX_QPS=
ZALOPAY_ENABLED=false
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_CREATE_URL=https://sb-openapi.zalopay.vn/v2/create
ZALOPAY_QUERY_URL=https://sb-openapi.zalopay.vn/v2/query
# Do not invent generic ZaloPay limits/HTTP timeout; confirm these with the merchant.
ZALOPAY_MIN_AMOUNT=
ZALOPAY_MAX_AMOUNT=
ZALOPAY_MAX_QPS=
ZALOPAY_CALLBACK_TIMEOUT_MS=

EMAIL_OUTBOX_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=GlowUp <noreply@glowup.vn>

# Isolated integration database only; never set this to the shared Neon database.
# TEST_DATABASE_URL=postgresql://postgres:sprint3_test_only@localhost:55433/glowup_sprint3_test?connection_limit=20

# Sprint 4: private evidence bucket, separate from the public catalog bucket.
RETURN_STORAGE_BUCKET=
RETURN_STORAGE_PRIVATE=false

# Enable only after SMTP/FCM are configured and integration-tested.
NOTIFICATION_DELIVERY_ENABLED=false
# Server-side secret, never exposed in Web/Mobile or API exports.
FCM_SERVICE_ACCOUNT_JSON=
