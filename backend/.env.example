# Application Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Neon PostgreSQL Database
# Thay thế chuỗi kết nối bằng DATABASE_URL từ bảng điều khiển Neon của bạn:
DATABASE_URL="postgresql://neondb_owner:password@ep-xxxxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_glowup_cosmetics_retail_system_2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_glowup_cosmetics_2026
JWT_REFRESH_EXPIRES_IN=30d

# Cloudflare R2 via S3. Leave unset to disable image uploads (503).
STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
STORAGE_REGION=auto
STORAGE_BUCKET=glowup-images
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL="https://images.example.com"

# Sprint 4: private evidence bucket, separate from the public catalog bucket.
RETURN_STORAGE_BUCKET=
RETURN_STORAGE_PRIVATE=false

# Enable only after SMTP/FCM are configured and integration-tested.
NOTIFICATION_DELIVERY_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Server-side secret, never exposed in Web/Mobile or API exports.
FCM_SERVICE_ACCOUNT_JSON=

# Upstash REST is used for cache and coupon rate limiting. Never put live tokens in this file.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
REDIS_URL=rediss://default:your-token@your-database.upstash.io:6379
# Isolate namespaces between environments. The REST adapter does not need REDIS_URL.
REDIS_KEY_PREFIX=glowup:development:
# Enable after applying Sprint 5 migration and verifying external provider configuration.
CATALOG_INDEX_WORKER_ENABLED=false
BROADCAST_WORKER_ENABLED=false

# Sprint 6: website origin and exact Web/Admin CORS origins (comma-separated).
# Production requires HTTPS and a strong JWT_SECRET, and configured Upstash for rate limits.
PUBLIC_WEB_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
# Keep false on local/staging; true only on the public production website.
SEO_INDEXING_ENABLED=false
# Explicit trusted proxy IPs/CIDRs only; leave blank when directly exposed locally.
TRUSTED_PROXIES=

# Web/Mobile Google client IDs, comma-separated. No Google client secret required for ID-token verification.
GOOGLE_OAUTH_CLIENT_IDS=
# Classic Facebook Login access-token flow; Limited Login JWT is not accepted.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Set the supported Graph API version from your registered Meta app (e.g. v24.0).
FACEBOOK_GRAPH_VERSION=
