{
  "info": {
    "name": "GlowUp Sprint 3 — backend end-user Việt Trung",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Gateway credentials stay in backend .env. Matching order gateway required. Native signed callbacks must come from the gateway; do not simulate sandbox acceptance by sending fabricated paid payloads. See backend/docs/sprint-3.md."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1"
    },
    {
      "key": "platform",
      "value": "WEB"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "paymentId",
      "value": ""
    },
    {
      "key": "notificationId",
      "value": ""
    },
    {
      "key": "oldPassword",
      "value": ""
    },
    {
      "key": "newPassword",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "browserReturnUrl",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Login — keep sid in JWT",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json().data;",
              "  pm.collectionVariables.set('accessToken', data.accessToken);",
              "  pm.collectionVariables.set('refreshToken', data.refreshToken);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Refresh ? CAS rotation, stable sid",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/auth/refresh-token",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json().data;",
              "  pm.collectionVariables.set('accessToken', data.accessToken);",
              "  pm.collectionVariables.set('refreshToken', data.refreshToken);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Create vnpay — server amount, merchant must be ready",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/payments/vnpay/create",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"platform\": \"{{platform}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Ready result or unknown attempt', () => pm.expect(pm.response.code).to.be.oneOf([200,202]));",
              "if ([200,202].includes(pm.response.code)) {",
              "  const data = pm.response.json().data;",
              "  pm.collectionVariables.set('paymentId', data.paymentId);",
              "  pm.collectionVariables.set('browserReturnUrl', data.returnUrl);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Create momo — server amount, merchant must be ready",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/payments/momo/create",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"platform\": \"{{platform}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Ready result or unknown attempt', () => pm.expect(pm.response.code).to.be.oneOf([200,202]));",
              "if ([200,202].includes(pm.response.code)) {",
              "  const data = pm.response.json().data;",
              "  pm.collectionVariables.set('paymentId', data.paymentId);",
              "  pm.collectionVariables.set('browserReturnUrl', data.returnUrl);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Create zalopay — server amount, merchant must be ready",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/payments/zalopay/create",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"platform\": \"{{platform}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Ready result or unknown attempt', () => pm.expect(pm.response.code).to.be.oneOf([200,202]));",
              "if ([200,202].includes(pm.response.code)) {",
              "  const data = pm.response.json().data;",
              "  pm.collectionVariables.set('paymentId', data.paymentId);",
              "  pm.collectionVariables.set('browserReturnUrl', data.returnUrl);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Owned payment status",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/payments/{{paymentId}}/status"
      }
    },
    {
      "name": "Get profile",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/users/me"
      }
    },
    {
      "name": "Update profile",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/users/me",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Nguyễn Văn A\",\n  \"phone\": \"0901234567\",\n  \"dateOfBirth\": \"2000-01-01\",\n  \"gender\": \"OTHER\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Change password — current access JWT must have sid",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/auth/change-password",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"oldPassword\": \"{{oldPassword}}\",\n  \"newPassword\": \"{{newPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Avatar — choose local JPG PNG WebP",
      "request": {
        "method": "POST",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/upload/avatar",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": []
            }
          ]
        }
      }
    },
    {
      "name": "Notifications",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/notifications?page=1&limit=20"
      }
    },
    {
      "name": "Read owned notification",
      "request": {
        "method": "PUT",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/notifications/{{notificationId}}/read"
      }
    },
    {
      "name": "Browser return — state only, never confirms money",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "noauth"
        },
        "url": "{{browserReturnUrl}}"
      }
    }
  ]
}
