# Copy into the Next.js project's .env.local; run Next with: npm run dev -- --port 3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
NEXT_PUBLIC_FACEBOOK_APP_ID=your-facebook-app-id
# Server-only URL for sitemap proxy/BFF. Not an OAuth client secret.
BACKEND_API_BASE_URL=http://localhost:3000/api/v1
