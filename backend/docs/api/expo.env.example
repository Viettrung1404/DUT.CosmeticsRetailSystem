# Android Emulator on the same PC. For a physical phone, replace 10.0.2.2 with the PC's LAN IP.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000/api/v1
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_FACEBOOK_APP_ID=your-facebook-app-id
# Add native Android/iOS provider registrations in the client app, per its SDK/config plugin.
# Never add FACEBOOK_APP_SECRET, GOOGLE_CLIENT_SECRET, JWT_SECRET or storage keys here.
