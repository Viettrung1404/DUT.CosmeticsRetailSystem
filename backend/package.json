{
  "name": "glowup-backend",
  "version": "1.0.0",
  "description": "GlowUp Cosmetics Retail System Backend - Clean Architecture with NestJS & Prisma",
  "author": "GlowUp Team",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:schema:export": "node scripts/export-db-schema.cjs",
    "seed:products": "node --env-file=.env scripts/catalog/seed.cjs",
    "seed:products:clean": "node --env-file=.env scripts/catalog/seed.cjs --clean-legacy",
    "seed:stores": "node --env-file=.env -r ts-node/register/transpile-only prisma/seed-stores.ts",
    "catalog:collect": "python scripts/catalog/collect.py --target 390",
    "catalog:gallery": "python scripts/catalog/enrich.py --images 3",
    "catalog:normalize": "node scripts/catalog/normalize.cjs",
    "catalog:validate": "node scripts/catalog/validate.cjs",
    "catalog:upload": "node --env-file=.env scripts/catalog/upload.cjs",
    "catalog:serve": "node scripts/catalog/serve.cjs",
    "catalog:publish": "node --env-file=.env scripts/catalog/publish.cjs",
    "catalog:verify": "node --env-file=.env scripts/catalog/verify.cjs",
    "catalog:test": "node --test scripts/catalog/normalize.test.cjs",
    "demo:brands": "python scripts/demo/collect-brands.py",
    "demo:brands:official": "python scripts/demo/collect-official-brands.py",
    "demo:ingredients:official": "python scripts/demo/collect-official-ingredients.py",
    "demo:logos:review": "python scripts/demo/review-brand-assets.py && node scripts/demo/prepare-official-logos.cjs",
    "catalog:enrich": "node --env-file=.env scripts/demo/enrich-catalog.cjs --apply",
    "catalog:enrich:preview": "node --env-file=.env scripts/demo/enrich-catalog.cjs",
    "catalog:enrich:verify": "node --env-file=.env scripts/demo/verify-enrichment.cjs",
    "seed:quota:exhausted": "node --env-file=.env scripts/demo/seed-exhausted-quota.cjs",
    "demo:assets": "node scripts/demo/build-assets.cjs",
    "demo:upload": "node --env-file=.env scripts/demo/upload-assets.cjs",
    "seed:foundation": "node --env-file=.env scripts/demo/seed-foundation.cjs",
    "seed:scenarios": "node --env-file=.env scripts/demo/seed-scenarios.cjs",
    "demo:verify": "node --env-file=.env scripts/demo/verify.cjs",
    "demo:test": "node --test scripts/demo/fixtures.test.cjs scripts/demo/enrichment.test.cjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@elastic/elasticsearch": "^9.5.1",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/elasticsearch": "^12.0.1",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^6.4.1",
    "bcrypt": "6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "crypto-js": "^4.2.0",
    "lossless-json": "^4.3.1",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "11.3.1",
    "nodemailer": "^10.0.10",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sanitize-html": "2.18.1",
    "sharp": "^0.35.5",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/bcrypt": "^5.0.2",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.1",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.9.10",
    "prisma": "^6.4.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": {
            "allowJs": true
          }
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@core/(.*)$": "<rootDir>/core/$1",
      "^@modules/(.*)$": "<rootDir>/modules/$1",
      "^@infrastructure/(.*)$": "<rootDir>/infrastructure/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(htmlparser2|domhandler|domutils|domelementtype|dom-serializer|entities|launder)/)"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
