  productVariantId String   @map("product_variant_id") @db.Uuid
  promotionId      String?  @map("promotion_id") @db.Uuid
  productName      String   @map("product_name") @db.VarChar(255)
  variantName      String   @map("variant_name") @db.VarChar(150)
  quantity         Int
  unitPrice        Decimal  @map("unit_price") @db.Decimal(12, 2)
  unitCost         Decimal  @map("unit_cost") @db.Decimal(12, 2)
  discountAmount   Decimal  @default(0) @map("discount_amount") @db.Decimal(12, 2)
  pointsDiscount   Decimal  @default(0) @map("points_discount") @db.Decimal(12, 2)
  totalPrice       Decimal  @map("total_price") @db.Decimal(12, 2)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  order            Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant          ProductVariant    @relation(fields: [productVariantId], references: [id])
  promotion        Promotion?        @relation(fields: [promotionId], references: [id])
