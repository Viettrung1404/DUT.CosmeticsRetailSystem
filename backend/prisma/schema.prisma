model PurchaseOrder {
  id           String    @id @default(uuid()) @db.Uuid
  poNumber     String    @unique @map("po_number") @db.VarChar(50)
  supplierId   String    @map("supplier_id") @db.Uuid
  storeId      String    @map("store_id") @db.Uuid
  status       String    @db.VarChar(30)
  totalAmount  Decimal   @map("total_amount") @db.Decimal(12, 2)
  note         String?   @db.Text
  createdBy    String?   @map("created_by") @db.Uuid
  approvedBy   String?   @map("approved_by") @db.Uuid
  approvedAt   DateTime? @map("approved_at") @db.Timestamptz
  expectedDate DateTime? @map("expected_date") @db.Date
  receivedDate DateTime? @map("received_date") @db.Date
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  supplier         Supplier            @relation(fields: [supplierId], references: [id])
  store            Store               @relation(fields: [storeId], references: [id])
  creator          User?               @relation("CreatedPurchaseOrders", fields: [createdBy], references: [id])
  approver         User?               @relation("ApprovedPurchaseOrders", fields: [approvedBy], references: [id])
