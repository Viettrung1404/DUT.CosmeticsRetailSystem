// Sprint 4: customer command receipts, RMA and durable delivery.
model CommandReceipt {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  operation      String   @db.VarChar(60)
  idempotencyKey String   @map("idempotency_key") @db.VarChar(128)
  requestHash    String   @map("request_hash") @db.VarChar(64)
  result         Json     @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  user           User     @relation(fields: [userId], references: [id])

  @@unique([userId, operation, idempotencyKey])
