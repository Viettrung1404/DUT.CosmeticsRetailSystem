  returnUrl         String? @map("return_url") @db.Text
  paymentUrl        String? @map("payment_url") @db.Text
  walletDeeplink    String? @map("wallet_deeplink") @db.Text
  qrCodeData        String? @map("qr_code_data") @db.Text
  expiresAt         DateTime? @map("expires_at") @db.Timestamptz
  requestSnapshot   Json? @map("request_snapshot") @db.JsonB
