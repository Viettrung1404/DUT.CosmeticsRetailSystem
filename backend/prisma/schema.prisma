model Customer {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String?   @unique @map("user_id") @db.Uuid
  phone         String?   @unique @db.VarChar(20)
  fullName      String?   @map("full_name") @db.VarChar(100)
  loyaltyTierId String?   @map("loyalty_tier_id") @db.Uuid
  totalPoints   Int       @default(0) @map("total_points")
  totalSpent    Decimal   @default(0) @map("total_spent") @db.Decimal(12, 2)
  totalOrders   Int       @default(0) @map("total_orders")
  dateOfBirth   DateTime? @map("date_of_birth") @db.Date
  gender        String?   @db.VarChar(10)
  referralCode  String?   @unique @map("referral_code") @db.VarChar(20)
  referredBy    String?   @map("referred_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user                User?                      @relation(fields: [userId], references: [id])
  loyaltyTier         LoyaltyTier?               @relation(fields: [loyaltyTierId], references: [id])
  referrer            Customer?                  @relation("CustomerReferral", fields: [referredBy], references: [id])
  referees            Customer[]                 @relation("CustomerReferral")
  addresses           CustomerAddress[]
  loyaltyTransactions LoyaltyPointsTransaction[]
  wishlists           Wishlist[]
  reviews             Review[]
  carts               Cart[]
  orders              Order[]
  returnOrders        ReturnOrder[]
  coupons             Coupon[]
  couponUsages        CouponUsage[]
  invoices            Invoice[]

  @@map("customers")
}

model CustomerAddress {
  id            String   @id @default(uuid()) @db.Uuid
  customerId    String   @map("customer_id") @db.Uuid
  label         String?  @db.VarChar(50)
  recipientName String   @map("recipient_name") @db.VarChar(100)
  phone         String   @db.VarChar(20)
  addressLine   String   @map("address_line") @db.VarChar(255)
  city          String   @db.VarChar(100)
  district      String   @db.VarChar(100)
  ward          String   @db.VarChar(100)
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_addresses")
}

model LoyaltyTier {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String   @db.VarChar(50)
  minPoints          Int      @map("min_points")
  discountPercentage Decimal  @default(0) @map("discount_percentage") @db.Decimal(5, 2)
  pointMultiplier    Decimal  @default(1.0) @map("point_multiplier") @db.Decimal(5, 2)
  benefits           Json?    @db.JsonB
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  customers Customer[]

  @@map("loyalty_tiers")
}

model LoyaltyPointsTransaction {
  id          String    @id @default(uuid()) @db.Uuid
  customerId  String    @map("customer_id") @db.Uuid
  orderId     String?   @map("order_id") @db.Uuid
  points      Int
  type        String    @db.VarChar(20)
  description String?   @db.VarChar(255)
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order    Order?   @relation(fields: [orderId], references: [id])

  @@map("loyalty_points_transactions")
}

model Wishlist {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@map("wishlists")
}

model Review {
  id                 String   @id @default(uuid()) @db.Uuid
  customerId         String   @map("customer_id") @db.Uuid
  productId          String   @map("product_id") @db.Uuid
  orderId            String?  @map("order_id") @db.Uuid
  rating             Int
  title              String?  @db.VarChar(255)
  content            String?  @db.Text
  isVerifiedPurchase Boolean  @default(false) @map("is_verified_purchase")
  isApproved         Boolean  @default(false) @map("is_approved")
  adminReply         String?  @map("admin_reply") @db.Text
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  order    Order?   @relation(fields: [orderId], references: [id])

  @@map("reviews")
}

// =============================================================================
// 7. HR & EMPLOYEE (Bảng 40 - 44)
// =============================================================================

model Department {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  employees Employee[]

  @@map("departments")
}

model Employee {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  storeId        String?  @map("store_id") @db.Uuid
  departmentId   String?  @map("department_id") @db.Uuid
  employeeCode   String   @unique @map("employee_code") @db.VarChar(20)
  position       String   @db.VarChar(100)
  hireDate       DateTime @map("hire_date") @db.Date
  salary         Decimal? @db.Decimal(12, 2)
  commissionRate Decimal  @default(0) @map("commission_rate") @db.Decimal(5, 2)
  status         String   @default("ACTIVE") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user               User         @relation(fields: [userId], references: [id])
  store              Store?       @relation("EmployeeStore", fields: [storeId], references: [id])
  department         Department?  @relation(fields: [departmentId], references: [id])
  managedStores      Store[]      @relation("StoreManager")
  attendances        Attendance[]
  commissions        Commission[]
  ordersAsSalesStaff Order[]

  @@map("employees")
}

model Shift {
  id        String   @id @default(uuid()) @db.Uuid
  storeId   String?  @map("store_id") @db.Uuid
  name      String   @db.VarChar(50)
  startTime String   @map("start_time") @db.VarChar(10)
  endTime   String   @map("end_time") @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  store       Store?       @relation(fields: [storeId], references: [id])
  attendances Attendance[]

  @@map("shifts")
}

model Attendance {
  id          String    @id @default(uuid()) @db.Uuid
  employeeId  String    @map("employee_id") @db.Uuid
  shiftId     String?   @map("shift_id") @db.Uuid
  date        DateTime  @db.Date
  checkInAt   DateTime? @map("check_in_at") @db.Timestamptz
  checkOutAt  DateTime? @map("check_out_at") @db.Timestamptz
  status      String?   @db.VarChar(20)
  note        String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift    Shift?   @relation(fields: [shiftId], references: [id])

  @@map("attendance")
}

model Commission {
  id          String   @id @default(uuid()) @db.Uuid
  employeeId  String   @map("employee_id") @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  amount      Decimal  @db.Decimal(12, 2)
  rate        Decimal  @db.Decimal(5, 2)
  periodMonth Int      @map("period_month")
  periodYear  Int      @map("period_year")
  status      String   @default("PENDING") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  order    Order    @relation(fields: [orderId], references: [id])

  @@map("commissions")
}

// =============================================================================
// 8. SUPPLIER & PROCUREMENT (Bảng 45 - 48)
// =============================================================================

model Supplier {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @db.VarChar(200)
  contactPerson String?  @map("contact_person") @db.VarChar(100)
  email         String?  @db.VarChar(100)
  phone         String?  @db.VarChar(20)
  address       String?  @db.Text
  taxCode       String?  @map("tax_code") @db.VarChar(50)
  paymentTerms  String?  @map("payment_terms") @db.Text
  rating        Decimal? @db.Decimal(3, 2)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  batches          Batch[]
  purchaseOrders   PurchaseOrder[]
  supplierPayments SupplierPayment[]

  @@map("suppliers")
}

model PurchaseOrder {
  id           String    @id @default(uuid()) @db.Uuid
  poNumber     String    @unique @map("po_number") @db.VarChar(50)
  supplierId   String    @map("supplier_id") @db.Uuid
  storeId      String    @map("store_id") @db.Uuid
  status       String    @db.VarChar(30)
  totalAmount  Decimal   @map("total_amount") @db.Decimal(12, 2)
  note         String?   @db.Text
  createdBy    String?   @map("created_by") @db.Uuid
  expectedDate DateTime? @map("expected_date") @db.Date
  receivedDate DateTime? @map("received_date") @db.Date
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  supplier         Supplier            @relation(fields: [supplierId], references: [id])
  store            Store               @relation(fields: [storeId], references: [id])
  creator          User?               @relation(fields: [createdBy], references: [id])
  items            PurchaseOrderItem[]
  batches          Batch[]
  supplierPayments SupplierPayment[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String   @id @default(uuid()) @db.Uuid
  purchaseOrderId  String   @map("purchase_order_id") @db.Uuid
  productVariantId String   @map("product_variant_id") @db.Uuid
  quantityOrdered  Int      @map("quantity_ordered")
  quantityReceived Int      @default(0) @map("quantity_received")
  unitCost         Decimal  @map("unit_cost") @db.Decimal(12, 2)
  totalCost        Decimal  @map("total_cost") @db.Decimal(12, 2)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  purchaseOrder PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [productVariantId], references: [id])

  @@map("purchase_order_items")
}

model SupplierPayment {
  id              String   @id @default(uuid()) @db.Uuid
  supplierId      String   @map("supplier_id") @db.Uuid
  purchaseOrderId String?  @map("purchase_order_id") @db.Uuid
  amount          Decimal  @db.Decimal(12, 2)
  paymentMethod   String   @map("payment_method") @db.VarChar(50)
  paymentDate     DateTime @map("payment_date") @db.Date
  status          String   @db.VarChar(20)
  note            String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  @@map("supplier_payments")
}

// =============================================================================
// 9. MARKETING (Bảng 49 - 51)
// =============================================================================

model Promotion {
  id                   String   @id @default(uuid()) @db.Uuid
  name                 String   @db.VarChar(200)
  description          String?  @db.Text
  type                 String   @db.VarChar(30)
  value                Decimal  @db.Decimal(12, 2)
  minOrderAmount       Decimal  @default(0) @map("min_order_amount") @db.Decimal(12, 2)
  maxDiscountAmount    Decimal? @map("max_discount_amount") @db.Decimal(12, 2)
  startDate            DateTime @map("start_date") @db.Timestamptz
  endDate              DateTime @map("end_date") @db.Timestamptz
  isActive             Boolean  @default(true) @map("is_active")
  usageLimit           Int?     @map("usage_limit")
  usedCount            Int      @default(0) @map("used_count")
  applicableProducts   Json?    @map("applicable_products") @db.JsonB
  applicableCategories Json?    @map("applicable_categories") @db.JsonB
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  coupons    Coupon[]
  orderItems OrderItem[]

  @@map("promotions")
}

model Coupon {
  id                 String   @id @default(uuid()) @db.Uuid
  promotionId        String?  @map("promotion_id") @db.Uuid
  customerId         String?  @map("customer_id") @db.Uuid
  code               String   @unique @db.VarChar(50)
  discountType       String   @map("discount_type") @db.VarChar(20)
  discountValue      Decimal  @map("discount_value") @db.Decimal(12, 2)
  minOrderAmount     Decimal  @default(0) @map("min_order_amount") @db.Decimal(12, 2)
  maxUses            Int?     @map("max_uses")
  usedCount          Int      @default(0) @map("used_count")
  maxUsesPerCustomer Int      @default(1) @map("max_uses_per_customer")
  startDate          DateTime @map("start_date") @db.Timestamptz
  endDate            DateTime @map("end_date") @db.Timestamptz
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  promotion Promotion?    @relation(fields: [promotionId], references: [id])
  customer  Customer?     @relation(fields: [customerId], references: [id])
  orders    Order[]
  usages    CouponUsage[]

  @@index([customerId])
  @@map("coupons")
}

model CouponUsage {
  id             String   @id @default(uuid()) @db.Uuid
  couponId       String   @map("coupon_id") @db.Uuid
  customerId     String   @map("customer_id") @db.Uuid
  orderId        String   @unique @map("order_id") @db.Uuid
  discountAmount Decimal  @map("discount_amount") @db.Decimal(12, 2)
  usedAt         DateTime @default(now()) @map("used_at") @db.Timestamptz
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  coupon   Coupon   @relation(fields: [couponId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  order    Order    @relation(fields: [orderId], references: [id])

  @@map("coupon_usage")
}

// =============================================================================
// 10. CMS (Bảng 52 - 56)
// =============================================================================

model Page {
  id              String   @id @default(uuid()) @db.Uuid
  title           String   @db.VarChar(255)
  slug            String   @unique @db.VarChar(255)
  content         String   @db.Text
  metaTitle       String?  @map("meta_title") @db.VarChar(255)
  metaDescription String?  @map("meta_description") @db.Text
  isPublished     Boolean  @default(false) @map("is_published")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("pages")
}

model BlogPost {
  id              String    @id @default(uuid()) @db.Uuid
  title           String    @db.VarChar(255)
  slug            String    @unique @db.VarChar(255)
  content         String    @db.Text
  excerpt         String?   @db.Text
  featuredImage   String?   @map("featured_image") @db.Text
  blogCategoryId  String?   @map("blog_category_id") @db.Uuid
  authorId        String?   @map("author_id") @db.Uuid
  status          String    @default("DRAFT") @db.VarChar(20)
  publishedAt     DateTime? @map("published_at") @db.Timestamptz
  metaTitle       String?   @map("meta_title") @db.VarChar(255)
  metaDescription String?   @map("meta_description") @db.Text
  viewsCount      Int       @default(0) @map("views_count")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  category BlogCategory? @relation(fields: [blogCategoryId], references: [id])
  author   User?         @relation(fields: [authorId], references: [id])

  @@map("blog_posts")
}

model BlogCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(150)
  slug        String   @unique @db.VarChar(150)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  posts BlogPost[]

  @@map("blog_categories")
}

model Banner {
  id        String    @id @default(uuid()) @db.Uuid
  title     String?   @db.VarChar(150)
  imageUrl  String    @map("image_url") @db.Text
  linkUrl   String?   @map("link_url") @db.Text
  position  String    @db.VarChar(50)
  sortOrder Int       @default(0) @map("sort_order")
  startDate DateTime? @map("start_date") @db.Timestamptz
  endDate   DateTime? @map("end_date") @db.Timestamptz
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("banners")
}

model Faq {
  id        String   @id @default(uuid()) @db.Uuid
  question  String   @db.VarChar(500)
  answer    String   @db.Text
  category  String?  @db.VarChar(100)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("faqs")
}

// =============================================================================
// 11. SYSTEM (Bảng 57 - 60)
// =============================================================================

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String   @db.VarChar(255)
  message   String   @db.Text
  type      String   @db.VarChar(50)
  data      Json?    @db.JsonB
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model UserDevice {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  deviceToken  String    @unique @map("device_token") @db.VarChar(255)
  platform     String    @db.VarChar(20)
  deviceName   String?   @map("device_name") @db.VarChar(100)
  appVersion   String?   @map("app_version") @db.VarChar(20)
  isActive     Boolean   @default(true) @map("is_active")
  lastActiveAt DateTime? @map("last_active_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("user_devices")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(50)
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   String   @map("entity_id") @db.Uuid
  oldData    Json?    @map("old_data") @db.JsonB
  newData    Json?    @map("new_data") @db.JsonB
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model Setting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(100)
  value       Json     @db.JsonB
  group       String?  @db.VarChar(50)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([value], type: Gin, map: "idx_settings_value")
  @@map("settings")
}

// =============================================================================
// 12. INVOICING & FINANCIAL DOCUMENTS (Bảng 61 - 62)
// =============================================================================

model Invoice {
  id                String   @id @default(uuid()) @db.Uuid
  invoiceSeries     String   @map("invoice_series") @db.VarChar(20)
  invoiceNumber     String   @unique @map("invoice_number") @db.VarChar(50)
  lookupCode        String   @unique @map("lookup_code") @db.VarChar(100)
  orderId           String   @map("order_id") @db.Uuid
  replacesInvoiceId String?  @map("replaces_invoice_id") @db.Uuid
  storeId           String   @map("store_id") @db.Uuid
  customerId        String?  @map("customer_id") @db.Uuid
  buyerName         String   @map("buyer_name") @db.VarChar(150)
  buyerTaxCode      String?  @map("buyer_tax_code") @db.VarChar(50)
  buyerAddress      String?  @map("buyer_address") @db.Text
  buyerEmail        String?  @map("buyer_email") @db.VarChar(255)
  buyerPhone        String?  @map("buyer_phone") @db.VarChar(20)
  subtotal          Decimal  @db.Decimal(12, 2)
  taxRate           Decimal  @default(10.00) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount         Decimal  @map("tax_amount") @db.Decimal(12, 2)
  totalAmount       Decimal  @map("total_amount") @db.Decimal(12, 2)
  paymentMethod     String   @map("payment_method") @db.VarChar(50)
  status            String   @default("ISSUED") @db.VarChar(30)
  einvoiceProvider  String?  @map("einvoice_provider") @db.VarChar(50)
  einvoiceUrl       String?  @map("einvoice_url") @db.Text
  issuedAt          DateTime @default(now()) @map("issued_at") @db.Timestamptz
  issuedBy          String   @map("issued_by") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  order           Order         @relation(fields: [orderId], references: [id])
  replacesInvoice Invoice?      @relation("InvoiceReplacement", fields: [replacesInvoiceId], references: [id])
  replacedBy      Invoice[]     @relation("InvoiceReplacement")
  store           Store         @relation(fields: [storeId], references: [id])
  customer        Customer?     @relation(fields: [customerId], references: [id])
  issuer          User          @relation(fields: [issuedBy], references: [id])
  items           InvoiceItem[]

  @@index([orderId])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @map("invoice_id") @db.Uuid
  orderItemId String   @map("order_item_id") @db.Uuid
  itemName    String   @map("item_name") @db.VarChar(255)
  unit        String   @db.VarChar(20)
  quantity    Int
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  taxRate     Decimal  @default(10.00) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount   Decimal  @map("tax_amount") @db.Decimal(12, 2)
  totalAmount Decimal  @map("total_amount") @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  invoice   Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  @@map("invoice_items")
}
