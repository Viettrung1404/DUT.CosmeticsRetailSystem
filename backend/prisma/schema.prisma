// =============================================================================
// PRISMA SCHEMA CHO HỆ THỐNG GLOWUP COSMETICS RETAIL SYSTEM
// Database: PostgreSQL 17 (Neon Serverless)
// Quy chuẩn thiết kế: 62 bảng, 12 phân hệ theo docs/2-design/04_thiet_ke_csdl.md
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// 1. AUTHENTICATION & USER MANAGEMENT (Bảng 1 - 6 + user_sessions)
// =============================================================================

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(50)
  displayName String   @map("display_name") @db.VarChar(100)
  description String?  @db.Text
  permissions BigInt   @default(0)
  dataScope   String   @default("SELF") @map("data_scope") @db.VarChar(20)
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  users User[]

  @@map("roles")
}

model Permission {
  bitPosition    Int     @id @map("bit_position") @db.SmallInt
  bitValue       BigInt  @unique @map("bit_value")
  permissionCode String  @unique @map("permission_code") @db.VarChar(100)
  permissionName String  @map("permission_name") @db.VarChar(100)
  module         String  @db.VarChar(50)
  description    String? @db.Text

  @@map("permissions")
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  roleId             Int       @default(6) @map("role_id")
  email              String    @unique @db.VarChar(255)
  passwordHash       String?   @map("password_hash") @db.VarChar(255)
  phone              String?   @unique @db.VarChar(20)
  fullName           String    @map("full_name") @db.VarChar(100)
  avatarUrl          String?   @map("avatar_url") @db.Text
  status             String    @default("ACTIVE") @db.VarChar(20)
  emailVerified      Boolean   @default(false) @map("email_verified")
  phoneVerified      Boolean   @default(false) @map("phone_verified")
  extraPermissions   BigInt    @default(0) @map("extra_permissions")
  revokedPermissions BigInt    @default(0) @map("revoked_permissions")
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  role                       Role                  @relation(fields: [roleId], references: [id])
  userStores                 UserStore[]
  oauthAccounts              UserOAuthAccount[]
  verificationTokens         VerificationToken[]
  userSessions               UserSession[]
  employee                   Employee?
  customer                   Customer?
  devices                    UserDevice[]
  notifications              Notification[]
  emailOutbox                 EmailOutbox[]
  auditLogs                  AuditLog[]
  orderStatusHistories       OrderStatusHistory[]
  posSessionsAsCashier       PosSession[]          @relation("CashierSessions")
  posSessionsApproved        PosSession[]          @relation("ApprovedSessions")
  refundsProcessed           Refund[]              @relation("RefundProcessor")
  returnHistoryChanges       ReturnStatusHistory[] @relation("ReturnHistoryActor")
  inventoryTransactions      InventoryTransaction[]
  searchHistories            SearchHistory[]
  transfersRequested         InventoryTransfer[]   @relation("RequestedTransfers")
  transfersApproved          InventoryTransfer[]   @relation("ApprovedTransfers")
  transfersShipped           InventoryTransfer[]   @relation("ShippedTransfers")
  transfersReceived          InventoryTransfer[]   @relation("ReceivedTransfers")
  adjustmentsCreated         InventoryAdjustment[] @relation("CreatedAdjustments")
  adjustmentsApproved        InventoryAdjustment[] @relation("ApprovedAdjustments")
  stocktakesCreated         Stocktake[]           @relation("CreatedStocktakes")
  stocktakesCompleted        Stocktake[]           @relation("CompletedStocktakes")
  purchaseOrdersCreated      PurchaseOrder[]       @relation("CreatedPurchaseOrders")
  purchaseOrdersApproved     PurchaseOrder[]       @relation("ApprovedPurchaseOrders")
  goodsReceiptsReceived      GoodsReceipt[]
  supplierPaymentsCreated    SupplierPayment[]
  blogPosts                  BlogPost[]
  invoicesIssued             Invoice[]
  returnOrdersHandled        ReturnOrder[]
  commandReceipts CommandReceipt[]
  returnAttachments ReturnAttachment[]
  receivedReturnReceipts ReturnReceipt[]
  performedInspections ReturnInspection[]
  executedDispositions InventoryDisposition[]

  @@index([roleId])
  @@map("users")
}

model UserStore {
  userId     String   @map("user_id") @db.Uuid
  storeId    String   @map("store_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([userId, storeId])
  @@map("user_stores")
}

model UserOAuthAccount {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  provider       String   @db.VarChar(50)
  providerUserId String   @map("provider_user_id") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("user_oauth_accounts")
}

model OAuthPendingIdentity {
  id               String    @id @default(uuid()) @db.Uuid
  provider         String    @db.VarChar(50)
  subject          String    @db.VarChar(255)
  fullName         String    @map("full_name") @db.VarChar(100)
  email            String?   @db.VarChar(255)
  targetUserId     String?   @map("target_user_id") @db.Uuid
  challengeHash    String    @unique @map("challenge_hash") @db.VarChar(64)
  clientHash       String    @map("client_hash") @db.VarChar(64)
  verificationHash String?   @map("verification_hash") @db.VarChar(64)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz
  usedAt           DateTime? @map("used_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([expiresAt])
  @@map("oauth_pending_identities")
}

model VerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  tokenHash String   @map("token_hash") @db.VarChar(255)
  type      String   @db.VarChar(50)
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  isUsed    Boolean  @default(false) @map("is_used")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("verification_tokens")
}

model UserSession {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  refreshToken String   @unique @map("refresh_token") @db.VarChar(500)
  deviceInfo   String?  @map("device_info") @db.VarChar(255)
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  isRevoked    Boolean  @default(false) @map("is_revoked")
  expiresAt    DateTime @map("expires_at") @db.Timestamptz
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

// =============================================================================
// 2. PRODUCT & CATALOG (Bảng 7 - 13)
// =============================================================================

model Category {
  id              String   @id @default(uuid()) @db.Uuid
  parentId        String?  @map("parent_id") @db.Uuid
  name            String   @db.VarChar(150)
  slug            String   @unique @db.VarChar(150)
  description     String?  @db.Text
  imageUrl        String?  @map("image_url") @db.Text
  sortOrder       Int      @default(0) @map("sort_order")
  isActive        Boolean  @default(true) @map("is_active")
  metaTitle       String?  @map("meta_title") @db.VarChar(255)
  metaDescription String?  @map("meta_description") @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]
  returnPolicyRules ReturnPolicyRule[]

  @@index([parentId])
  @@map("categories")
}

model Brand {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @db.VarChar(100)
  slug            String   @unique @db.VarChar(150)
  logoUrl         String?  @map("logo_url") @db.Text
  bannerUrl       String?  @map("banner_url") @db.Text
  description     String?  @db.Text
  countryOfOrigin String?  @map("country_of_origin") @db.VarChar(100)
  websiteUrl      String?  @map("website_url") @db.VarChar(255)
  sortOrder       Int      @default(0) @map("sort_order")
  isFeatured      Boolean  @default(false) @map("is_featured")
  isActive        Boolean  @default(true) @map("is_active")
  metaTitle       String?  @map("meta_title") @db.VarChar(255)
  metaDescription String?  @map("meta_description") @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  products Product[]

  @@map("brands")
}

model Product {
  id               String   @id @default(uuid()) @db.Uuid
  categoryId       String   @map("category_id") @db.Uuid
  brandId          String?  @map("brand_id") @db.Uuid
  name             String   @db.VarChar(255)
  slug             String   @unique @db.VarChar(255)
  sku              String   @unique @db.VarChar(50)
  description      String?  @db.Text
  shortDescription String?  @map("short_description") @db.Text
  howToUse         String?  @map("how_to_use") @db.Text
  specifications   Json?    @map("specifications") @db.JsonB
  basePrice        Decimal  @map("base_price") @db.Decimal(12, 2)
  salePrice        Decimal? @map("sale_price") @db.Decimal(12, 2)
  option1Name      String?  @map("option1_name") @db.VarChar(50)
  option2Name      String?  @map("option2_name") @db.VarChar(50)
  option3Name      String?  @map("option3_name") @db.VarChar(50)
  videoUrl         String?  @map("video_url") @db.Text
  isActive         Boolean  @default(true) @map("is_active")
  isFeatured       Boolean  @default(false) @map("is_featured")
  avgRating        Decimal  @default(0) @map("avg_rating") @db.Decimal(3, 2)
  totalReviews     Int      @default(0) @map("total_reviews")
  totalSold        Int      @default(0) @map("total_sold")
  metaTitle        String?  @map("meta_title") @db.VarChar(255)
  metaDescription  String?  @map("meta_description") @db.Text
  metaKeywords     String?  @map("meta_keywords") @db.VarChar(255)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  category    Category            @relation(fields: [categoryId], references: [id])
  brand       Brand?              @relation(fields: [brandId], references: [id])
  variants    ProductVariant[]
  images      ProductImage[]
  ingredients ProductIngredient[]
  tags        ProductTag[]
  wishlists   Wishlist[]
  reviews     Review[]

  @@index([categoryId, brandId, isActive])
  @@index([brandId])
  @@map("products")
}

model ProductVariant {
  promotionQuotas PromotionVariantQuota[]
  id              String                  @id @default(uuid()) @db.Uuid
  productId       String                  @map("product_id") @db.Uuid
  sku             String                  @unique @db.VarChar(50)
  option1Value    String?                 @map("option1_value") @db.VarChar(100)
  option2Value    String?                 @map("option2_value") @db.VarChar(100)
  option3Value    String?                 @map("option3_value") @db.VarChar(100)
  tryOnColorHex   String?                 @map("try_on_color_hex") @db.VarChar(7)
  price           Decimal                 @db.Decimal(12, 2)
  costPrice       Decimal                 @map("cost_price") @db.Decimal(12, 2)
  weight          Decimal?                @db.Decimal(8, 2)
  unit            String?                 @db.VarChar(20)
  stockQuantity   Int                     @default(0) @map("stock_quantity")
  minShelfLifeDays Int                    @default(180) @map("min_shelf_life_days")
  barcode         String?                 @unique @db.VarChar(100)
  isActive        Boolean                 @default(true) @map("is_active")
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  product               Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  images                ProductImage[]
  inventory             Inventory[]
  inventoryLots         InventoryLot[]
  inventoryReservationItems InventoryReservationItem[]
  inventoryTransactions InventoryTransaction[]
  batches               Batch[]
  transferItems         InventoryTransferItem[]
  stocktakeItems        StocktakeItem[]
  adjustmentItems       InventoryAdjustmentItem[]
  cartItems             CartItem[]
  orderItems            OrderItem[]
  returnOrderItems      ReturnOrderItem[]
  purchaseOrderItems    PurchaseOrderItem[]
  exchangeItems         ExchangeItem[]
  fulfillmentOrderItems FulfillmentOrderItem[]
  packageItems          PackageItem[]
  inventoryDispositions InventoryDisposition[]

  @@unique([productId, option1Value, option2Value, option3Value])
  @@index([productId, isActive])
  @@map("product_variants")
}

model ProductImage {
  id               String   @id @default(uuid()) @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  productVariantId String?  @map("product_variant_id") @db.Uuid
  imageUrl         String   @map("image_url") @db.Text
  altText          String?  @map("alt_text") @db.VarChar(255)
  sortOrder        Int      @default(0) @map("sort_order")
  isPrimary        Boolean  @default(false) @map("is_primary")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([productVariantId])
  @@map("product_images")
}

model ProductIngredient {
  id              String   @id @default(uuid()) @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  ingredientName  String   @map("ingredient_name") @db.VarChar(150)
  percentage      String?  @db.VarChar(20)
  purpose         String?  @db.VarChar(500)
  isKeyIngredient Boolean  @default(false) @map("is_key_ingredient")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_ingredients")
}

model ProductTag {
  productId String   @map("product_id") @db.Uuid
  tagName   String   @map("tag_name") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, tagName])
  @@index([tagName])
  @@map("product_tags")
}

// =============================================================================
// 3. STORE & INVENTORY (Bảng 14 - 21)
// =============================================================================

model Store {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(150)
  code         String   @unique @db.VarChar(20)
  type         String   @default("STORE") @db.VarChar(20)
  address      String   @db.Text
  city         String   @db.VarChar(100)
  district     String   @db.VarChar(100)
  phone        String?  @db.VarChar(20)
  email        String?  @db.VarChar(100)
  managerId    String?  @map("manager_id") @db.Uuid
  latitude     Decimal? @db.Decimal(10, 8)
  longitude    Decimal? @db.Decimal(11, 8)
  openingHours Json?    @map("opening_hours") @db.JsonB
  isActive     Boolean  @default(true) @map("is_active")
  fulfillmentCapacityPerDay Int @default(500) @map("fulfillment_capacity_per_day")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  manager               Employee?              @relation("StoreManager", fields: [managerId], references: [id])
  employees             Employee[]             @relation("EmployeeStore")
  userStores            UserStore[]
  inventory             Inventory[]
  inventoryLots         InventoryLot[]
  inventoryReservations InventoryReservation[]
  inventoryTransactions InventoryTransaction[]
  batches               Batch[]
  transfersFrom         InventoryTransfer[]    @relation("TransferFromStore")
  transfersTo           InventoryTransfer[]    @relation("TransferToStore")
  stocktakes            Stocktake[]
  inventoryAdjustments  InventoryAdjustment[]
  carts                 Cart[]
  orders                Order[]
  posSessions           PosSession[]
  purchaseOrders        PurchaseOrder[]
  goodsReceipts         GoodsReceipt[]
  invoices              Invoice[]
  returnOrders          ReturnOrder[]
  dropoffReturnOrders   ReturnOrder[]          @relation("ReturnDropoffStore")
  returnReceipts        ReturnReceipt[]
  restockReturnItems    ReturnOrderItem[]      @relation("RestockStore")
  shifts                Shift[]
  shippingQuotes        ShippingQuote[]
  fulfillmentOrders     FulfillmentOrder[]
  inventoryDispositions InventoryDisposition[]

  @@map("stores")
}

model Inventory {
  id                String    @id @default(uuid()) @db.Uuid
  storeId           String    @map("store_id") @db.Uuid
  productVariantId  String    @map("product_variant_id") @db.Uuid
  quantity          Int       @default(0)
  reservedQuantity  Int       @default(0) @map("reserved_quantity")
  safetyStock       Int       @default(0) @map("safety_stock")
  quarantinedQuantity Int     @default(0) @map("quarantined_quantity")
  damagedQuantity   Int       @default(0) @map("damaged_quantity")
  // Cột GENERATED (quantity - reserved_quantity - safety_stock - quarantined_quantity - damaged_quantity), tạo trong migration. Chỉ đọc, không ghi.
  availableQuantity Int?      @default(dbgenerated()) @map("available_quantity")
  minQuantity       Int       @default(5) @map("min_quantity")
  maxQuantity       Int?      @map("max_quantity")
  lastRestockAt     DateTime? @map("last_restock_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  store   Store          @relation(fields: [storeId], references: [id])
  variant ProductVariant @relation(fields: [productVariantId], references: [id])

  @@unique([storeId, productVariantId])
  @@index([productVariantId])
  @@map("inventory")
}

model InventoryTransaction {
  id               String   @id @default(uuid()) @db.Uuid
  storeId          String   @map("store_id") @db.Uuid
  productVariantId String   @map("product_variant_id") @db.Uuid
  batchId          String?  @map("batch_id") @db.Uuid
  transactionType  String   @map("transaction_type") @db.VarChar(20)
  quantity         Int
  referenceType    String?  @map("reference_type") @db.VarChar(50)
  referenceId      String?  @map("reference_id") @db.Uuid
  note             String?  @db.Text
  createdBy        String?  @map("created_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  store   Store          @relation(fields: [storeId], references: [id])
  variant ProductVariant @relation(fields: [productVariantId], references: [id])
  batch   Batch?         @relation(fields: [batchId], references: [id])
  creator User?          @relation(fields: [createdBy], references: [id])

  @@index([storeId, createdAt(sort: Desc)], map: "idx_inventory_transactions_store_created")
  @@map("inventory_transactions")
}

model Batch {
  id               String    @id @default(uuid()) @db.Uuid
  productVariantId String    @map("product_variant_id") @db.Uuid
  storeId          String    @map("store_id") @db.Uuid
  batchNumber      String    @map("batch_number") @db.VarChar(100)
  quantity         Int
  manufactureDate  DateTime? @map("manufacture_date") @db.Date
  expiryDate       DateTime  @map("expiry_date") @db.Date
  supplierId       String?   @map("supplier_id") @db.Uuid
  purchaseOrderId  String?   @map("purchase_order_id") @db.Uuid
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  variant            ProductVariant          @relation(fields: [productVariantId], references: [id])
  store              Store                   @relation(fields: [storeId], references: [id])
  supplier           Supplier?               @relation(fields: [supplierId], references: [id])
  purchaseOrder      PurchaseOrder?          @relation(fields: [purchaseOrderId], references: [id])
  transactions       InventoryTransaction[]
  transferItems      InventoryTransferItem[]
  stocktakeItems     StocktakeItem[]
  adjustmentItems    InventoryAdjustmentItem[]
  orderItemBatches   OrderItemBatch[]
  restockReturnItems ReturnOrderItem[]       @relation("RestockBatch")

  @@unique([storeId, productVariantId, batchNumber])
  @@index([productVariantId, storeId, expiryDate])
  @@map("batches")
}

model InventoryLot {
  id               String         @id @default(uuid()) @db.Uuid
  locationId       String         @map("location_id") @db.Uuid
  productVariantId String         @map("product_variant_id") @db.Uuid
  batchCode        String         @map("batch_code") @db.VarChar(100)
  expiryDate       DateTime       @map("expiry_date") @db.Date
  quantityOnHand   Int            @default(0) @map("quantity_on_hand")
  quantityReserved Int            @default(0) @map("quantity_reserved")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  location         Store          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  variant          ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  reservationItems InventoryReservationItem[]
  inventoryDispositions InventoryDisposition[]

  @@unique([locationId, productVariantId, batchCode], map: "uq_lot_batch")
  @@index([locationId, productVariantId, expiryDate], map: "idx_lots_fefo_search")
  @@map("inventory_lots")
}

model InventoryReservation {
  id                 String                     @id @default(uuid()) @db.Uuid
  orderId            String?                    @map("order_id") @db.Uuid
  fulfillmentOrderId String?                    @unique @map("fulfillment_order_id") @db.Uuid
  locationId         String                     @map("location_id") @db.Uuid
  status             String                     @default("ACTIVE") @db.VarChar(30)
  expiresAt          DateTime                   @map("expires_at") @db.Timestamptz
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  order              Order?                     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  location           Store                      @relation(fields: [locationId], references: [id], onDelete: Restrict)
  fulfillmentOrder   FulfillmentOrder?          @relation(fields: [fulfillmentOrderId], references: [id], onDelete: Cascade)
  items              InventoryReservationItem[]

  @@index([status, expiresAt], map: "idx_res_cleanup")
  @@map("inventory_reservations")
}

model InventoryReservationItem {
  id               String               @id @default(uuid()) @db.Uuid
  reservationId    String               @map("reservation_id") @db.Uuid
  productVariantId String               @map("product_variant_id") @db.Uuid
  lotId            String               @map("lot_id") @db.Uuid
  quantity         Int

  reservation      InventoryReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  variant          ProductVariant       @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  lot              InventoryLot         @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@index([reservationId], map: "idx_reservation_items_res_id")
  @@map("inventory_reservation_items")
}

model InventoryTransfer {
  id           String    @id @default(uuid()) @db.Uuid
  transferCode String    @unique @map("transfer_code") @db.VarChar(50)
  fromStoreId  String    @map("from_store_id") @db.Uuid
  toStoreId    String    @map("to_store_id") @db.Uuid
  status       String    @db.VarChar(30)
  requestedBy  String?   @map("requested_by") @db.Uuid
  approvedBy   String?   @map("approved_by") @db.Uuid
  shippedBy    String?   @map("shipped_by") @db.Uuid
  receivedBy   String?   @map("received_by") @db.Uuid
  shippedAt    DateTime? @map("shipped_at") @db.Timestamptz
  receivedAt   DateTime? @map("received_at") @db.Timestamptz
  note         String?   @db.Text
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  fromStore Store                   @relation("TransferFromStore", fields: [fromStoreId], references: [id])
  toStore   Store                   @relation("TransferToStore", fields: [toStoreId], references: [id])
