  reason              String    @db.VarChar(100)
  refundAmount        Decimal   @default(0) @map("refund_amount") @db.Decimal(12, 2)
  handledBy           String?   @map("handled_by") @db.Uuid
  adminNote           String?   @map("admin_note") @db.Text
  policyVersionId     String?   @map("policy_version_id") @db.Uuid
  dropoffLocationId   String?   @map("dropoff_location_id") @db.Uuid
  pickupAddress       Json?     @map("pickup_address") @db.JsonB
  returnChannel       String    @default("STORE_DROPOFF") @map("return_channel") @db.VarChar(30)
