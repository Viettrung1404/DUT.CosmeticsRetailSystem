model Shipment {
  id                 String    @id @default(uuid()) @db.Uuid
  orderId            String    @map("order_id") @db.Uuid
  shipmentCode       String    @unique @map("shipment_code") @db.VarChar(60)
  shipmentType       String    @default("OUTBOUND") @map("shipment_type") @db.VarChar(30)
  fulfillmentOrderId String?   @map("fulfillment_order_id") @db.Uuid
  returnOrderId      String?   @map("return_order_id") @db.Uuid
  carrierCode        String    @map("carrier_code") @db.VarChar(50)
  carrierServiceCode String?   @map("carrier_service_code") @db.VarChar(50)
  trackingCode       String?   @unique @map("tracking_code") @db.VarChar(100)
  carrierReferenceId String?   @map("carrier_reference_id") @db.VarChar(100)
  status             String    @db.VarChar(35)
  codAmount          Decimal   @default(0) @map("cod_amount") @db.Decimal(12, 2)
  codStatus          String?   @default("COD_EXPECTED") @map("cod_status") @db.VarChar(30)
  shippingFeePaid    Decimal   @default(0) @map("shipping_fee_paid") @db.Decimal(12, 2)
  actualShippingFee  Decimal?  @default(0) @map("actual_shipping_fee") @db.Decimal(12, 2)
  shippingLabelUrl   String?   @map("shipping_label_url") @db.Text
  trackingUrl        String?   @map("tracking_url") @db.Text
  carrierMetadata    Json?     @map("carrier_metadata") @db.JsonB
  handedOverAt       DateTime? @map("handed_over_at") @db.Timestamptz
  deliveredAt        DateTime? @map("delivered_at") @db.Timestamptz
  failedAttempts     Int       @default(0) @map("failed_attempts")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  order              Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fulfillmentOrder   FulfillmentOrder?  @relation(fields: [fulfillmentOrderId], references: [id], onDelete: SetNull)
  returnOrder        ReturnOrder?       @relation(fields: [returnOrderId], references: [id], onDelete: SetNull)
  events             ShipmentEvent[]
  packages           ShipmentPackage[]
  attempts           ShipmentAttempt[]
  codReconciliationItems CodReconciliationItem[]
  claims             CarrierClaim[]


  @@index([orderId, status])
  @@index([fulfillmentOrderId])
  @@index([returnOrderId])
  @@index([carrierCode, trackingCode], map: "idx_shipments_carrier_tracking")
  @@index([carrierMetadata], type: Gin, map: "idx_shipments_carrier_metadata")
  @@map("shipments")
}

model OrderStatusHistory {
