  refundItems      RefundItem[]
  invoiceItems     InvoiceItem[]
  fulfillmentOrderItems FulfillmentOrderItem[]
  pricingSnapshot  Json?             @map("pricing_snapshot") @db.JsonB

  @@index([promotionId])
  @@index([orderId])
  @@index([productVariantId])
  @@map("order_items")
}

model OrderItemBatch {
