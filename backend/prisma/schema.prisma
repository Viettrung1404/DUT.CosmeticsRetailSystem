// =============================================================================
// PRISMA SCHEMA CHO HỆ THỐNG GLOWUP COSMETICS RETAIL SYSTEM
// Database: PostgreSQL 17 (Neon Serverless)
// Quy chuẩn thiết kế: 62 bảng, 12 phân hệ theo docs/2-design/04_thiet_ke_csdl.md
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// 1. AUTHENTICATION & USER MANAGEMENT (Bảng 1 - 6 + user_sessions)
// =============================================================================

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(50)
  displayName String   @map("display_name") @db.VarChar(100)
  description String?  @db.Text
  permissions BigInt   @default(0)
  dataScope   String   @default("SELF") @map("data_scope") @db.VarChar(20)
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  users User[]

  @@map("roles")
}

model Permission {
  bitPosition    Int     @id @map("bit_position") @db.SmallInt
  bitValue       BigInt  @unique @map("bit_value")
  permissionCode String  @unique @map("permission_code") @db.VarChar(100)
  permissionName String  @map("permission_name") @db.VarChar(100)
  module         String  @db.VarChar(50)
  description    String? @db.Text

  @@map("permissions")
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  roleId             Int       @default(6) @map("role_id")
  email              String    @unique @db.VarChar(255)
  passwordHash       String?   @map("password_hash") @db.VarChar(255)
  phone              String?   @unique @db.VarChar(20)
  fullName           String    @map("full_name") @db.VarChar(100)
  avatarUrl          String?   @map("avatar_url") @db.Text
  status             String    @default("ACTIVE") @db.VarChar(20)
  emailVerified      Boolean   @default(false) @map("email_verified")
  phoneVerified      Boolean   @default(false) @map("phone_verified")
  extraPermissions   BigInt    @default(0) @map("extra_permissions")
  revokedPermissions BigInt    @default(0) @map("revoked_permissions")
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  role                       Role                  @relation(fields: [roleId], references: [id])
  userStores                 UserStore[]
  oauthAccounts              UserOAuthAccount[]
  verificationTokens         VerificationToken[]
  userSessions               UserSession[]
  employee                   Employee?
  customer                   Customer?
  devices                    UserDevice[]
  notifications              Notification[]
  auditLogs                  AuditLog[]
  orderStatusHistories       OrderStatusHistory[]
  posSessionsAsCashier       PosSession[]          @relation("CashierSessions")
  posSessionsApproved        PosSession[]          @relation("ApprovedSessions")
  inventoryTransactions      InventoryTransaction[]
  transfersRequested         InventoryTransfer[]   @relation("RequestedTransfers")
  transfersApproved          InventoryTransfer[]   @relation("ApprovedTransfers")
  stocktakesCreated          Stocktake[]           @relation("CreatedStocktakes")
  stocktakesCompleted        Stocktake[]           @relation("CompletedStocktakes")
  purchaseOrdersCreated      PurchaseOrder[]
  blogPosts                  BlogPost[]
  invoicesIssued             Invoice[]
  returnOrdersHandled        ReturnOrder[]

  @@index([roleId])
  @@map("users")
}

model UserStore {
  userId     String   @map("user_id") @db.Uuid
  storeId    String   @map("store_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([userId, storeId])
  @@map("user_stores")
}

model UserOAuthAccount {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  provider       String   @db.VarChar(50)
  providerUserId String   @map("provider_user_id") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@map("user_oauth_accounts")
}

model VerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  tokenHash String   @map("token_hash") @db.VarChar(255)
  type      String   @db.VarChar(50)
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  isUsed    Boolean  @default(false) @map("is_used")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("verification_tokens")
}

model UserSession {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  refreshToken String   @unique @map("refresh_token") @db.VarChar(500)
  deviceInfo   String?  @map("device_info") @db.VarChar(255)
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  isRevoked    Boolean  @default(false) @map("is_revoked")
  expiresAt    DateTime @map("expires_at") @db.Timestamptz
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

// =============================================================================
// 2. PRODUCT & CATALOG (Bảng 7 - 13)
// =============================================================================

model Category {
  id              String   @id @default(uuid()) @db.Uuid
  parentId        String?  @map("parent_id") @db.Uuid
  name            String   @db.VarChar(150)
  slug            String   @unique @db.VarChar(150)
  description     String?  @db.Text
  imageUrl        String?  @map("image_url") @db.Text
  sortOrder       Int      @default(0) @map("sort_order")
  isActive        Boolean  @default(true) @map("is_active")
  metaTitle       String?  @map("meta_title") @db.VarChar(255)
  metaDescription String?  @map("meta_description") @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@map("categories")
}

model Brand {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @db.VarChar(100)
  slug            String   @unique @db.VarChar(150)
  logoUrl         String?  @map("logo_url") @db.Text
  bannerUrl       String?  @map("banner_url") @db.Text
  description     String?  @db.Text
  countryOfOrigin String?  @map("country_of_origin") @db.VarChar(100)
  websiteUrl      String?  @map("website_url") @db.VarChar(255)
  sortOrder       Int      @default(0) @map("sort_order")
  isFeatured      Boolean  @default(false) @map("is_featured")
  isActive        Boolean  @default(true) @map("is_active")
  metaTitle       String?  @map("meta_title") @db.VarChar(255)
  metaDescription String?  @map("meta_description") @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  products Product[]

  @@map("brands")
}

model Product {
  id               String   @id @default(uuid()) @db.Uuid
  categoryId       String   @map("category_id") @db.Uuid
  brandId          String?  @map("brand_id") @db.Uuid
  name             String   @db.VarChar(255)
  slug             String   @unique @db.VarChar(255)
  sku              String   @unique @db.VarChar(50)
  description      String?  @db.Text
  shortDescription String?  @map("short_description") @db.Text
  basePrice        Decimal  @map("base_price") @db.Decimal(12, 2)
  salePrice        Decimal? @map("sale_price") @db.Decimal(12, 2)
  option1Name      String?  @map("option1_name") @db.VarChar(50)
  option2Name      String?  @map("option2_name") @db.VarChar(50)
  option3Name      String?  @map("option3_name") @db.VarChar(50)
  isActive         Boolean  @default(true) @map("is_active")
  isFeatured       Boolean  @default(false) @map("is_featured")
  avgRating        Decimal  @default(0) @map("avg_rating") @db.Decimal(3, 2)
  totalReviews     Int      @default(0) @map("total_reviews")
  totalSold        Int      @default(0) @map("total_sold")
  metaTitle        String?  @map("meta_title") @db.VarChar(255)
  metaDescription  String?  @map("meta_description") @db.Text
  metaKeywords     String?  @map("meta_keywords") @db.VarChar(255)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  category    Category            @relation(fields: [categoryId], references: [id])
  brand       Brand?              @relation(fields: [brandId], references: [id])
  variants    ProductVariant[]
  images      ProductImage[]
  ingredients ProductIngredient[]
  tags        ProductTag[]
  wishlists   Wishlist[]
  reviews     Review[]

  @@index([categoryId, brandId, isActive])
  @@map("products")
}

model ProductVariant {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  sku           String   @unique @db.VarChar(50)
  option1Value  String?  @map("option1_value") @db.VarChar(100)
  option2Value  String?  @map("option2_value") @db.VarChar(100)
  option3Value  String?  @map("option3_value") @db.VarChar(100)
  price         Decimal  @db.Decimal(12, 2)
  costPrice     Decimal  @map("cost_price") @db.Decimal(12, 2)
  weight        Decimal? @db.Decimal(8, 2)
  unit          String?  @db.VarChar(20)
  stockQuantity Int      @default(0) @map("stock_quantity")
  barcode       String?  @unique @db.VarChar(100)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  product               Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  images                ProductImage[]
  inventory             Inventory[]
  inventoryTransactions InventoryTransaction[]
  batches               Batch[]
  transferItems         InventoryTransferItem[]
  stocktakeItems        StocktakeItem[]
  cartItems             CartItem[]
  orderItems            OrderItem[]
  returnOrderItems      ReturnOrderItem[]
  purchaseOrderItems    PurchaseOrderItem[]

  @@unique([productId, option1Value, option2Value, option3Value])
  @@map("product_variants")
}

model ProductImage {
  id               String   @id @default(uuid()) @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  productVariantId String?  @map("product_variant_id") @db.Uuid
  imageUrl         String   @map("image_url") @db.Text
  altText          String?  @map("alt_text") @db.VarChar(255)
  sortOrder        Int      @default(0) @map("sort_order")
  isPrimary        Boolean  @default(false) @map("is_primary")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductIngredient {
  id               String   @id @default(uuid()) @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  ingredientName   String   @map("ingredient_name") @db.VarChar(150)
  percentage       String?  @db.VarChar(20)
  isKeyIngredient  Boolean  @default(false) @map("is_key_ingredient")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_ingredients")
}

model ProductTag {
  productId String   @map("product_id") @db.Uuid
  tagName   String   @map("tag_name") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, tagName])
  @@map("product_tags")
}

// =============================================================================
// 3. STORE & INVENTORY (Bảng 14 - 21)
// =============================================================================

model Store {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(150)
  code         String   @unique @db.VarChar(20)
  type         String   @default("STORE") @db.VarChar(20)
  address      String   @db.Text
  city         String   @db.VarChar(100)
  district     String   @db.VarChar(100)
  phone        String?  @db.VarChar(20)
  email        String?  @db.VarChar(100)
  managerId    String?  @map("manager_id") @db.Uuid
  latitude     Decimal? @db.Decimal(10, 8)
  longitude    Decimal? @db.Decimal(11, 8)
  openingHours Json?    @map("opening_hours") @db.JsonB
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  manager               Employee?              @relation("StoreManager", fields: [managerId], references: [id])
  employees             Employee[]             @relation("EmployeeStore")
  userStores            UserStore[]
  inventory             Inventory[]
  inventoryTransactions InventoryTransaction[]
  batches               Batch[]
  transfersFrom         InventoryTransfer[]    @relation("TransferFromStore")
  transfersTo           InventoryTransfer[]    @relation("TransferToStore")
  stocktakes            Stocktake[]
  carts                 Cart[]
  orders                Order[]
  posSessions           PosSession[]
  purchaseOrders        PurchaseOrder[]
  invoices              Invoice[]
  returnOrders          ReturnOrder[]
  restockReturnItems    ReturnOrderItem[]      @relation("RestockStore")
  shifts                Shift[]

  @@map("stores")
}

model Inventory {
  id                String    @id @default(uuid()) @db.Uuid
  storeId           String    @map("store_id") @db.Uuid
  productVariantId  String    @map("product_variant_id") @db.Uuid
  quantity          Int       @default(0)
  reservedQuantity  Int       @default(0) @map("reserved_quantity")
  // Cột GENERATED (quantity - reserved_quantity), tạo trong migration add_db_constraints. Chỉ đọc, không ghi.
  availableQuantity Int?      @default(dbgenerated()) @map("available_quantity")
  minQuantity       Int       @default(5) @map("min_quantity")
  maxQuantity       Int?      @map("max_quantity")
  lastRestockAt     DateTime? @map("last_restock_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  store   Store          @relation(fields: [storeId], references: [id])
  variant ProductVariant @relation(fields: [productVariantId], references: [id])

  @@unique([storeId, productVariantId])
  @@map("inventory")
}

model InventoryTransaction {
  id               String   @id @default(uuid()) @db.Uuid
  storeId          String   @map("store_id") @db.Uuid
  productVariantId String   @map("product_variant_id") @db.Uuid
  batchId          String?  @map("batch_id") @db.Uuid
  transactionType  String   @map("transaction_type") @db.VarChar(20)
  quantity         Int
  referenceType    String?  @map("reference_type") @db.VarChar(50)
  referenceId      String?  @map("reference_id") @db.Uuid
  note             String?  @db.Text
  createdBy        String?  @map("created_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  store   Store          @relation(fields: [storeId], references: [id])
  variant ProductVariant @relation(fields: [productVariantId], references: [id])
  batch   Batch?         @relation(fields: [batchId], references: [id])
  creator User?          @relation(fields: [createdBy], references: [id])

  @@map("inventory_transactions")
}

model Batch {
  id               String    @id @default(uuid()) @db.Uuid
  productVariantId String    @map("product_variant_id") @db.Uuid
  storeId          String    @map("store_id") @db.Uuid
  batchNumber      String    @map("batch_number") @db.VarChar(100)
  quantity         Int
  manufactureDate  DateTime? @map("manufacture_date") @db.Date
  expiryDate       DateTime  @map("expiry_date") @db.Date
  supplierId       String?   @map("supplier_id") @db.Uuid
  purchaseOrderId  String?   @map("purchase_order_id") @db.Uuid
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  variant            ProductVariant          @relation(fields: [productVariantId], references: [id])
  store              Store                   @relation(fields: [storeId], references: [id])
  supplier           Supplier?               @relation(fields: [supplierId], references: [id])
  purchaseOrder      PurchaseOrder?          @relation(fields: [purchaseOrderId], references: [id])
  transactions       InventoryTransaction[]
  transferItems      InventoryTransferItem[]
  stocktakeItems     StocktakeItem[]
  orderItemBatches   OrderItemBatch[]
  restockReturnItems ReturnOrderItem[]       @relation("RestockBatch")

  @@unique([storeId, productVariantId, batchNumber])
  @@index([productVariantId, storeId, expiryDate])
  @@map("batches")
}

model InventoryTransfer {
  id           String    @id @default(uuid()) @db.Uuid
  transferCode String    @unique @map("transfer_code") @db.VarChar(50)
  fromStoreId  String    @map("from_store_id") @db.Uuid
  toStoreId    String    @map("to_store_id") @db.Uuid
  status       String    @db.VarChar(30)
  requestedBy  String?   @map("requested_by") @db.Uuid
  approvedBy   String?   @map("approved_by") @db.Uuid
  shippedAt    DateTime? @map("shipped_at") @db.Timestamptz
  receivedAt   DateTime? @map("received_at") @db.Timestamptz
  note         String?   @db.Text
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  fromStore Store                   @relation("TransferFromStore", fields: [fromStoreId], references: [id])
  toStore   Store                   @relation("TransferToStore", fields: [toStoreId], references: [id])
  requester User?                   @relation("RequestedTransfers", fields: [requestedBy], references: [id])
  approver  User?                   @relation("ApprovedTransfers", fields: [approvedBy], references: [id])
  items     InventoryTransferItem[]

  @@index([fromStoreId, toStoreId, status])
  @@map("inventory_transfers")
}

model InventoryTransferItem {
  id                String   @id @default(uuid()) @db.Uuid
  transferId        String   @map("transfer_id") @db.Uuid
  productVariantId  String   @map("product_variant_id") @db.Uuid
  batchId           String?  @map("batch_id") @db.Uuid
  quantityRequested Int      @map("quantity_requested")
  quantityShipped   Int      @default(0) @map("quantity_shipped")
  quantityReceived  Int      @default(0) @map("quantity_received")
  // Cột GENERATED (quantity_shipped - quantity_received), tạo trong migration add_db_constraints. Chỉ đọc, không ghi.
  lossQuantity      Int?     @default(dbgenerated()) @map("loss_quantity")
  lossReason        String?  @map("loss_reason") @db.Text
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  transfer InventoryTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  variant  ProductVariant    @relation(fields: [productVariantId], references: [id])
  batch    Batch?            @relation(fields: [batchId], references: [id])

  @@map("inventory_transfer_items")
}

model Stocktake {
  id                 String    @id @default(uuid()) @db.Uuid
  stocktakeCode      String    @unique @map("stocktake_code") @db.VarChar(50)
  storeId            String    @map("store_id") @db.Uuid
  status             String    @db.VarChar(20)
  totalVarianceValue Decimal   @default(0) @map("total_variance_value") @db.Decimal(12, 2)
  note               String?   @db.Text
  createdBy          String?   @map("created_by") @db.Uuid
  completedBy        String?   @map("completed_by") @db.Uuid
  completedAt        DateTime? @map("completed_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz

  store     Store           @relation(fields: [storeId], references: [id])
  creator   User?           @relation("CreatedStocktakes", fields: [createdBy], references: [id])
  completer User?           @relation("CompletedStocktakes", fields: [completedBy], references: [id])
  items     StocktakeItem[]

  @@index([storeId, status])
  @@map("stocktakes")
}

model StocktakeItem {
  id               String   @id @default(uuid()) @db.Uuid
  stocktakeId      String   @map("stocktake_id") @db.Uuid
  productVariantId String   @map("product_variant_id") @db.Uuid
  batchId          String?  @map("batch_id") @db.Uuid
  systemQuantity   Int      @map("system_quantity")
  actualQuantity   Int      @map("actual_quantity")
  // Cột GENERATED (actual_quantity - system_quantity), tạo trong migration add_db_constraints. Chỉ đọc, không ghi.
  varianceQuantity Int?     @default(dbgenerated()) @map("variance_quantity")
  unitCost         Decimal  @map("unit_cost") @db.Decimal(12, 2)
  varianceReason   String?  @map("variance_reason") @db.VarChar(50)
  note             String?  @db.Text
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  stocktake Stocktake      @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [productVariantId], references: [id])
  batch     Batch?         @relation(fields: [batchId], references: [id])

  @@map("stocktake_items")
}

// =============================================================================
// 4. ORDER, CART, LOGISTICS & RMA (Bảng 22 - 30)
// =============================================================================

model Cart {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String?  @map("customer_id") @db.Uuid
  sessionId  String?  @map("session_id") @db.VarChar(255)
  storeId    String?  @map("store_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  customer Customer?  @relation(fields: [customerId], references: [id])
  store    Store?     @relation(fields: [storeId], references: [id])
  items    CartItem[]

  @@map("carts")
}

model CartItem {
  id               String   @id @default(uuid()) @db.Uuid
  cartId           String   @map("cart_id") @db.Uuid
  productVariantId String   @map("product_variant_id") @db.Uuid
  quantity         Int
  unitPrice        Decimal  @map("unit_price") @db.Decimal(12, 2)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [productVariantId], references: [id])

  @@map("cart_items")
}

model Order {
  id                 String   @id @default(uuid()) @db.Uuid
  orderNumber        String   @unique @map("order_number") @db.VarChar(50)
  customerId         String?  @map("customer_id") @db.Uuid
  storeId            String   @map("store_id") @db.Uuid
  orderType          String   @map("order_type") @db.VarChar(20)
  posSessionId       String?  @map("pos_session_id") @db.Uuid
  status             String   @db.VarChar(30)
  subtotal           Decimal  @db.Decimal(12, 2)
  discountAmount     Decimal  @default(0) @map("discount_amount") @db.Decimal(12, 2)
  shippingFee        Decimal  @default(0) @map("shipping_fee") @db.Decimal(12, 2)
  taxAmount          Decimal  @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount        Decimal  @map("total_amount") @db.Decimal(12, 2)
  shippingAddress    Json?    @map("shipping_address") @db.JsonB
  billingAddress     Json?    @map("billing_address") @db.JsonB
  note               String?  @db.Text
  couponId           String?  @map("coupon_id") @db.Uuid
  loyaltyPointsUsed  Int      @default(0) @map("loyalty_points_used")
  salesStaffId       String?  @map("sales_staff_id") @db.Uuid
  totalWeightGrams   Int?     @map("total_weight_grams")
  packageDimensions  Json?    @map("package_dimensions") @db.JsonB
  einvoiceStatus     String   @default("PENDING") @map("einvoice_status") @db.VarChar(30)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  customer            Customer?                  @relation(fields: [customerId], references: [id])
  store               Store                      @relation(fields: [storeId], references: [id])
  posSession          PosSession?                @relation(fields: [posSessionId], references: [id])
  coupon              Coupon?                    @relation(fields: [couponId], references: [id])
  salesStaff          Employee?                  @relation(fields: [salesStaffId], references: [id])
  items               OrderItem[]
  shipments           Shipment[]
  statusHistories     OrderStatusHistory[]
  returnOrders        ReturnOrder[]
  payments            Payment[]
  refunds             Refund[]
  loyaltyTransactions LoyaltyPointsTransaction[]
  couponUsage         CouponUsage?
  invoices            Invoice[]
  commissions         Commission[]
  reviews             Review[]

  @@index([customerId, createdAt])
  @@index([storeId, status])
  @@index([posSessionId])
  @@index([shippingAddress], type: Gin, map: "idx_orders_shipping_address")
  @@map("orders")
}

model OrderItem {
  id               String   @id @default(uuid()) @db.Uuid
  orderId          String   @map("order_id") @db.Uuid
  productVariantId String   @map("product_variant_id") @db.Uuid
  promotionId      String?  @map("promotion_id") @db.Uuid
  productName      String   @map("product_name") @db.VarChar(255)
  variantName      String   @map("variant_name") @db.VarChar(150)
  quantity         Int
  unitPrice        Decimal  @map("unit_price") @db.Decimal(12, 2)
  unitCost         Decimal  @map("unit_cost") @db.Decimal(12, 2)
  discountAmount   Decimal  @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalPrice       Decimal  @map("total_price") @db.Decimal(12, 2)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  order            Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant          ProductVariant    @relation(fields: [productVariantId], references: [id])
  promotion        Promotion?        @relation(fields: [promotionId], references: [id])
  orderItemBatches OrderItemBatch[]
  returnItems      ReturnOrderItem[]
  invoiceItems     InvoiceItem[]

  @@index([promotionId])
  @@map("order_items")
}

model OrderItemBatch {
  id          String   @id @default(uuid()) @db.Uuid
  orderItemId String   @map("order_item_id") @db.Uuid
  batchId     String   @map("batch_id") @db.Uuid
  quantity    Int
  allocatedAt DateTime @default(now()) @map("allocated_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  batch     Batch     @relation(fields: [batchId], references: [id])

  @@index([orderItemId, batchId])
  @@map("order_item_batches")
}

model Shipment {
  id                 String    @id @default(uuid()) @db.Uuid
  orderId            String    @map("order_id") @db.Uuid
  shipmentCode       String    @unique @map("shipment_code") @db.VarChar(50)
  carrierCode        String    @map("carrier_code") @db.VarChar(50)
  carrierServiceCode String?   @map("carrier_service_code") @db.VarChar(50)
  trackingCode       String?   @unique @map("tracking_code") @db.VarChar(100)
  codAmount          Decimal   @default(0) @map("cod_amount") @db.Decimal(12, 2)
  shippingFeePaid    Decimal   @map("shipping_fee_paid") @db.Decimal(12, 2)
  status             String    @db.VarChar(30)
  shippingLabelUrl   String?   @map("shipping_label_url") @db.Text
  carrierMetadata    Json?     @map("carrier_metadata") @db.JsonB
  handedOverAt       DateTime? @map("handed_over_at") @db.Timestamptz
  deliveredAt        DateTime? @map("delivered_at") @db.Timestamptz
  failedAttempts     Int       @default(0) @map("failed_attempts")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, status])
  @@index([carrierMetadata], type: Gin, map: "idx_shipments_carrier_metadata")
  @@map("shipments")
}

model OrderStatusHistory {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  status    String   @db.VarChar(30)
  note      String?  @db.Text
  changedBy String?  @map("changed_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changer User? @relation(fields: [changedBy], references: [id])

  @@map("order_status_history")
}

model ReturnOrder {
  id           String    @id @default(uuid()) @db.Uuid
  returnCode   String    @unique @map("return_code") @db.VarChar(50)
  orderId      String    @map("order_id") @db.Uuid
  customerId   String    @map("customer_id") @db.Uuid
  storeId      String    @map("store_id") @db.Uuid
  returnType   String    @map("return_type") @db.VarChar(20)
  status       String    @db.VarChar(30)
  reason       String    @db.VarChar(100)
  refundAmount Decimal   @default(0) @map("refund_amount") @db.Decimal(12, 2)
  handledBy    String?   @map("handled_by") @db.Uuid
  adminNote    String?   @map("admin_note") @db.Text
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  order    Order             @relation(fields: [orderId], references: [id])
  customer Customer          @relation(fields: [customerId], references: [id])
  store    Store             @relation(fields: [storeId], references: [id])
  handler  User?             @relation(fields: [handledBy], references: [id])
  items    ReturnOrderItem[]
  refunds  Refund[]

  @@index([orderId, status])
  @@map("return_orders")
}

model ReturnOrderItem {
  id               String   @id @default(uuid()) @db.Uuid
  returnOrderId    String   @map("return_order_id") @db.Uuid
  orderItemId      String   @map("order_item_id") @db.Uuid
  productVariantId String   @map("product_variant_id") @db.Uuid
  quantity         Int
  condition        String   @db.VarChar(30)
  restockStoreId   String?  @map("restock_store_id") @db.Uuid
  restockBatchId   String?  @map("restock_batch_id") @db.Uuid
  note             String?  @db.Text
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  returnOrder  ReturnOrder    @relation(fields: [returnOrderId], references: [id], onDelete: Cascade)
  orderItem    OrderItem      @relation(fields: [orderItemId], references: [id])
  variant      ProductVariant @relation(fields: [productVariantId], references: [id])
  restockStore Store?         @relation("RestockStore", fields: [restockStoreId], references: [id])
  restockBatch Batch?         @relation("RestockBatch", fields: [restockBatchId], references: [id])

  @@map("return_order_items")
}

// =============================================================================
// 5. PAYMENT, POS SESSIONS & SETTLEMENT (Bảng 31 - 33)
// =============================================================================

model PosSession {
  id           String    @id @default(uuid()) @db.Uuid
  sessionCode  String    @unique @map("session_code") @db.VarChar(50)
  storeId      String    @map("store_id") @db.Uuid
  cashierId    String    @map("cashier_id") @db.Uuid
  openedAt     DateTime  @default(now()) @map("opened_at") @db.Timestamptz
  closedAt     DateTime? @map("closed_at") @db.Timestamptz
  openingCash  Decimal   @default(0) @map("opening_cash") @db.Decimal(12, 2)
  systemCash   Decimal   @default(0) @map("system_cash") @db.Decimal(12, 2)
  countedCash  Decimal?  @map("counted_cash") @db.Decimal(12, 2)
  difference   Decimal?  @db.Decimal(12, 2)
  status       String    @default("OPEN") @db.VarChar(20)
  note         String?   @db.Text
  approvedBy   String?   @map("approved_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  store    Store     @relation(fields: [storeId], references: [id])
  cashier  User      @relation("CashierSessions", fields: [cashierId], references: [id])
  approver User?     @relation("ApprovedSessions", fields: [approvedBy], references: [id])
  orders   Order[]
  payments Payment[]

  @@index([storeId, status])
  @@map("pos_sessions")
}

model Payment {
  id              String    @id @default(uuid()) @db.Uuid
  orderId         String    @map("order_id") @db.Uuid
  posSessionId    String?   @map("pos_session_id") @db.Uuid
  paymentMethod   String    @map("payment_method") @db.VarChar(20)
  amount          Decimal   @db.Decimal(12, 2)
  status          String    @db.VarChar(20)
  transactionId   String?   @map("transaction_id") @db.VarChar(100)
  gatewayResponse Json?     @map("gateway_response") @db.JsonB
  paidAt          DateTime? @map("paid_at") @db.Timestamptz
  reconciledAt    DateTime? @map("reconciled_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  posSession PosSession? @relation(fields: [posSessionId], references: [id])
  refunds    Refund[]

  @@map("payments")
}

model Refund {
  id                  String    @id @default(uuid()) @db.Uuid
  orderId             String    @map("order_id") @db.Uuid
  paymentId           String?   @map("payment_id") @db.Uuid
  returnOrderId       String?   @map("return_order_id") @db.Uuid
  amount              Decimal   @db.Decimal(12, 2)
  reason              String    @db.Text
  status              String    @db.VarChar(20)
  refundTransactionId String?   @map("refund_transaction_id") @db.VarChar(100)
  processedAt         DateTime? @map("processed_at") @db.Timestamptz
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  order       Order        @relation(fields: [orderId], references: [id])
  payment     Payment?     @relation(fields: [paymentId], references: [id])
  returnOrder ReturnOrder? @relation(fields: [returnOrderId], references: [id])

  @@map("refunds")
}

