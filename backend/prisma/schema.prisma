model Order {
  promotionAllocations PromotionAllocation[]
  promotionUsages      PromotionOrderUsage[]
  id                   String                @id @default(uuid()) @db.Uuid
  orderNumber          String                @unique @map("order_number") @db.VarChar(50)
  customerId           String?               @map("customer_id") @db.Uuid
  storeId              String                @map("store_id") @db.Uuid
  orderType            String                @map("order_type") @db.VarChar(20)
  posSessionId         String?               @map("pos_session_id") @db.Uuid
  status               String                @db.VarChar(30)
  subtotal             Decimal               @db.Decimal(12, 2)
  discountAmount       Decimal               @default(0) @map("discount_amount") @db.Decimal(12, 2)
  shippingFee          Decimal               @default(0) @map("shipping_fee") @db.Decimal(12, 2)
  taxAmount            Decimal               @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount          Decimal               @map("total_amount") @db.Decimal(12, 2)
  shippingAddress      Json?                 @map("shipping_address") @db.JsonB
  billingAddress       Json?                 @map("billing_address") @db.JsonB
  note                 String?               @db.Text
  couponId             String?               @map("coupon_id") @db.Uuid
  loyaltyPointsUsed    Int                   @default(0) @map("loyalty_points_used")
  salesStaffId         String?               @map("sales_staff_id") @db.Uuid
  totalWeightGrams     Int?                  @map("total_weight_grams")
  packageDimensions    Json?                 @map("package_dimensions") @db.JsonB
  einvoiceStatus       String                @default("PENDING") @map("einvoice_status") @db.VarChar(30)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  customer                Customer?                  @relation(fields: [customerId], references: [id])
  store                   Store                      @relation(fields: [storeId], references: [id])
  posSession              PosSession?                @relation(fields: [posSessionId], references: [id])
  coupon                  Coupon?                    @relation(fields: [couponId], references: [id])
  salesStaff              Employee?                  @relation(fields: [salesStaffId], references: [id])
  items                   OrderItem[]
  inventoryReservations   InventoryReservation[]
  fulfillmentOrders       FulfillmentOrder[]
  shipments               Shipment[]
  statusHistories         OrderStatusHistory[]
  returnOrders            ReturnOrder[]
  payments                Payment[]
  refunds                 Refund[]
  loyaltyTransactions     LoyaltyPointsTransaction[]
  couponUsage             CouponUsage?
  invoices                Invoice[]
  commissions             Commission[]
  reviews                 Review[]
  pricingSnapshot         Json?                      @map("pricing_snapshot") @db.JsonB
  exchangeSettlement      ExchangeSettlement?
  outgoingExchangeFunding ExchangeFunding[]
  policyVersionId         String?                    @map("policy_version_id") @db.Uuid
  policyVersion           ReturnPolicyVersion?       @relation(fields: [policyVersionId], references: [id])

  @@index([customerId, createdAt])
  @@index([storeId, status])
  @@index([posSessionId])
  @@index([shippingAddress], type: Gin, map: "idx_orders_shipping_address")
  @@index([salesStaffId])
  @@index([status, createdAt])
  @@index([createdAt(sort: Desc)], map: "idx_orders_created_at_desc")
  @@index([policyVersionId])
  @@map("orders")
}

model OrderItem {
